rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Players Profile Collection
    match /players/{userId} {
      // Any authenticated user can read public player profile metadata
      allow read: if isAuthenticated();
      
      // Only the authenticated user can create or update their own profile document
      allow create, update: if isOwner(userId);
      
      // Deletions are forbidden in this phase
      allow delete: if false;

      // Subcollection for user's friends list
      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Friend Requests Collection
    match /friendRequests/{requestId} {
      // Sender or recipient can read request
      allow read: if isAuthenticated() && 
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      
      // Sender can create a pending request (cannot send to self)
      allow create: if isAuthenticated() && 
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.fromUid != request.resource.data.toUid;
      
      // Recipient can update status (accept/decline), sender can cancel
      allow update: if isAuthenticated() &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
        
      allow delete: if isAuthenticated() &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // 4-Player Party Lobby Collection
    match /parties/{partyId} {
      // Any authenticated user can read party lobby state (needed for invites/joining)
      allow read: if isAuthenticated();
      
      // Leader can create party with max 4 members
      allow create: if isAuthenticated() && 
        request.resource.data.leaderId == request.auth.uid &&
        request.resource.data.members.size() <= 4;
      
      // Leader or existing party members can update party state (e.g. ready state, map selection)
      allow update: if isAuthenticated() && 
        request.resource.data.members.size() <= 4;
        
      // Only leader can delete/dissolve party
      allow delete: if isAuthenticated() && resource.data.leaderId == request.auth.uid;
    }
  }
}
